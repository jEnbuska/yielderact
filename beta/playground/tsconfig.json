{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@types/web"],
    "jsx": "react-jsx",
    "jsxImportSource": "yract-beta",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "yract-beta": ["../src/index.ts"],
      "yract-beta/jsx-runtime": ["../src/jsx-runtime.ts"],
      "yract-beta/jsx-dev-runtime": ["../src/jsx-runtime.ts"]
    }
  },
  "include": ["src"]
}
