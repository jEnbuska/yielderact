{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "yract",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "yract": ["../src/index.ts"],
      "yract/jsx-runtime": ["../src/jsx-runtime.ts"],
      "yract/jsx-dev-runtime": ["../src/jsx-runtime.ts"]
    }
  },
  "include": ["src", "playwright.config.ts", "tests"]
}
