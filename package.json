{
  "name": "yract",
  "version": "0.1.0",
  "description": "JSX UI library focused on ease of use and easy to understanding the internals of the library it self",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:playground": "npm run typecheck --prefix playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "npm test --prefix playground",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jEnbuska/yract.git"
  },
  "keywords": [
    "jsx",
    "ui",
    "generator",
    "yield",
    "library"
  ],
  "author": "jEnbuska",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jEnbuska/yract/issues"
  },
  "homepage": "https://github.com/jEnbuska/yract#readme",
  "devDependencies": {
    "jsdom": "^29.0.2",
    "knip": "^6.14.2",
    "oxlint": "^1.42.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  }
}
