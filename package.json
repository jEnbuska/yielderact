{
  "name": "yract",
  "version": "0.1.0",
  "description": "JSX UI library focused on ease of use and easy to understanding the internals of the library it self",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.esm.js",
      "require": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.esm.js",
      "require": "./dist/jsx-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "test": "vitest run",
    "test:visual": "npm test --prefix examples",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome check --linter-enabled=false .",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jEnbuska/yielderact.git"
  },
  "keywords": [
    "jsx",
    "ui",
    "generator",
    "yield",
    "library"
  ],
  "author": "jEnbuska",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jEnbuska/yielderact/issues"
  },
  "homepage": "https://github.com/jEnbuska/yielderact#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "jsdom": "^26.1.0",
    "knip": "^5.86.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
