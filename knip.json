{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["duplicates"],
  "workspaces": {
    ".": {
      "entry": ["src/index.ts", "src/jsx-runtime.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "playground": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "playwright": false,
      "vite": false
    }
  }
}
