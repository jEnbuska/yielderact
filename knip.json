{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": ["duplicates"],
  "workspaces": {
    ".": {
      "entry": ["playwright-tests/fixtures.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignore": ["src/__tests__/**"]
    },
    "examples": {
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "playwright": false,
      "vite": { "config": [] },
      "ignoreDependencies": ["yielderact"]
    }
  }
}
